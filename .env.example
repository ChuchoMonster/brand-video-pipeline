# Copy to .env and fill in. Never commit .env.

# ElevenLabs — narration (TTS, eleven_multilingual_v2) and music underbed (music_v1)
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-default-voice-id

# HeyGen — talking-photo avatar generation (Avatar V / IV)
# HyperFrames (the local renderer) does NOT need this key.
HEYGEN_API_KEY=your-heygen-api-key
HEYGEN_TALKING_PHOTO_ID=your-default-talking-photo-look-id

# KIE.AI — Nano Banana 2 image generation (B-roll)
# https://kie.ai/
KIE_AI_API_KEY=your-kie-ai-api-key
